---
import Base from '../layouts/Base.astro';
import { CV } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="CV">
  <div class="wrap">
    <div class="page-head">
      <h1>Curriculum Vitae</h1>
      <p class="cv-loc">{CV.location}</p>
      <p>{CV.summary}</p>
      <div class="btns"><a class="btn solid" href={`${base}${CV.pdf}`} download>Download PDF</a></div>
    </div>

    <section class="block">
      <h2 class="reveal">Experience</h2>
      {CV.experience.map((x) => (
        <div class="cv-item reveal">
          <h3>{x.role} · {x.org}</h3>
          <div class="meta">{x.when} · {x.where}</div>
          <ul>{x.points.map((p) => <li>{p}</li>)}</ul>
          <div>{x.tools.map((t) => <span class="tag">{t}</span>)}</div>
        </div>
      ))}
    </section>

    <section class="block">
      <h2 class="reveal">Education</h2>
      {CV.education.map((x) => (
        <div class="cv-item reveal">
          <h3>{x.title}</h3>
          <div class="meta">{x.org} · {x.when}</div>
          {x.note && <p class="cv-note">{x.note}</p>}
        </div>
      ))}
      <div class="reveal cv-courses">
        <strong>Relevant coursework</strong><br />
        {CV.coursework.map((c) => <span class="tag">{c}</span>)}
      </div>
    </section>

    <section class="block">
      <h2 class="reveal">Projects</h2>
      {CV.projects.map((p) => (
        <div class="cv-item reveal">
          <h3>{p.title}</h3>
          <div class="meta">{p.when} · {p.kind}</div>
          <p class="cv-note">{p.text}</p>
        </div>
      ))}
    </section>

    <section class="block">
      <h2 class="reveal">Skills</h2>
      {CV.skills.map((s) => (
        <div class="reveal cv-skill">
          <strong>{s.group}</strong><br />
          {s.items.map((i) => <span class="tag">{i}</span>)}
        </div>
      ))}
    </section>

    <section class="block">
      <h2 class="reveal">Beyond work</h2>
      <dl class="cv-extra reveal">
        {CV.extra.map((e) => (<><dt>{e.label}</dt><dd>{e.text}</dd></>))}
      </dl>
    </section>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import { PROJECTS } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Projects">
  <div class="wide">
    <div class="page-head">
      <h1>Projects</h1>
      <p>Things I built, broke and learned from. Add new ones in <code>src/config.ts</code>.</p>
    </div>
    <div class="grid" style="padding-bottom:90px">
      {PROJECTS.map((p) => (
        <a class="card reveal" href={`${base}${p.href}`} style="color:inherit">
          <h3>{p.title}</h3>
          <div class="meta">{p.when}</div>
          <p><em>{p.subtitle}</em></p>
          <p>{p.summary}</p>
          {p.tags.map((t) => <span class="tag">{t}</span>)}
        </a>
      ))}
    </div>
  </div>
</Base>

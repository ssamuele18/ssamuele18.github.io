---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const kinds = (['Work', 'Personal', 'University'] as const).filter((k) => projects.some((p) => p.data.kind === k));
const fmt = (d: Date) => d.toLocaleDateString('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Projects">
  <div class="wide">
    <div class="page-head">
      <h1>Projects</h1>
      <p>Things I built, broke and learned from: university work, personal experiments and more.</p>
    </div>

    {kinds.length > 1 && (
      <div class="filters" role="group" aria-label="Filter projects">
        <button type="button" class="chip" aria-pressed="true" data-kind="all">All <span>{projects.length}</span></button>
        {kinds.map((k) => (
          <button type="button" class="chip" aria-pressed="false" data-kind={k}>
            {k} <span>{projects.filter((p) => p.data.kind === k).length}</span>
          </button>
        ))}
      </div>
    )}

    <div class="grid projects-grid">
      {projects.map((p) => (
        <a class="card project-card reveal" href={`${base}/projects/${p.id}`} data-kind={p.data.kind} style="color:inherit">
          <div class="project-top">
            <span class={`kind kind-${p.data.kind.toLowerCase()}`}>{p.data.kind}</span>
            <span class="meta">{fmt(p.data.date)}</span>
          </div>
          <h3>{p.data.title}</h3>
          <p>{p.data.summary}</p>
          {p.data.stack.map((t) => <span class="tag">{t}</span>)}
        </a>
      ))}
    </div>
  </div>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filters .chip');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const k = chip.dataset.kind;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      cards.forEach((card) => { card.hidden = k !== 'all' && card.dataset.kind !== k; });
    })
  );
</script>

---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, PROJECTS } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const latest = (await getCollection('tlr', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="hero-inner wide">
      <div class="eyebrow">hello, world</div>
      <h1>{SITE.name}</h1>
      <p class="lead">{SITE.tagline}</p>
      <p class="lead">{SITE.intro}</p>
      <div class="btns">
        <a class="btn solid" href={`${base}/cv`}>View CV</a>
        <a class="btn" href={`${base}/projects`}>See projects</a>
      </div>
    </div>
    <div class="scroll-hint">scroll ↓</div>
  </section>

  <section class="block">
    <div class="wide">
      <h2 class="reveal">Selected projects</h2>
      <div class="grid">
        {PROJECTS.map((p) => (
          <a class="card reveal" href={`${base}${p.href}`} style="color:inherit">
            <h3>{p.title}</h3>
            <div class="meta">{p.when}</div>
            <p>{p.subtitle}</p>
            {p.tags.map((t) => <span class="tag">{t}</span>)}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wide">
      <h2 class="reveal">Latest from TLR</h2>
      <div class="grid">
        {latest.map((e) => (
          <a class="card reveal" href={`${base}/tlr/${e.id}`} style="color:inherit">
            <h3>{e.data.title}</h3>
            <div class="meta">{e.data.date.toLocaleDateString('en', { month: 'short', year: 'numeric' })}</div>
            <p>{e.data.abstract}</p>
            {e.data.tags.map((t) => <span class="tag">{t}</span>)}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

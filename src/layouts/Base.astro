---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE } from '../config';
import RegressionBackground from '../components/RegressionBackground.astro';

interface Props { title?: string; description?: string; favicon?: string; }
const { title, description = SITE.tagline, favicon } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const nav = [
  { href: `${base}/`, label: 'Home', match: (p: string) => p === `${base}/` || p === base },
  { href: `${base}/cv`, label: 'CV', match: (p: string) => p.startsWith(`${base}/cv`) },
  { href: `${base}/projects`, label: 'Projects', match: (p: string) => p.startsWith(`${base}/projects`) },
  { href: `${base}/tlr`, label: 'TLR', match: (p: string) => p.startsWith(`${base}/tlr`) },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline>
      // Applica il tema prima del primo disegno (niente flash): scelta salvata, altrimenti quella di sistema
      (function () {
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <meta name="theme-color" content="#f2e9dc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1c18" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&family=Manrope:wght@600;700;800&display=swap" />
    {favicon
      ? <link rel="icon" href={`${base}${favicon}`} type="image/png" />
      : <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />}
  </head>
  <body>
    <RegressionBackground />
    <header class="nav">
      <div class="nav-bar">
        <a class="brand" href={`${base}/`}>{SITE.name}</a>
        <div class="nav-right">
          <nav>
            <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a></li>
            ))}
            </ul>
          </nav>
          <button class="theme-toggle" type="button" aria-label="Toggle light and dark mode" title="Light / dark">
            <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer>
      <div class="wide">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span>
          {SITE.links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
        </span>
      </div>
    </footer>

    <script>
      // Tasto tema: alterna chiaro/scuro, ricorda la scelta e avvisa lo sfondo
      const root = document.documentElement;
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("theme", next); } catch (e) {}
        window.dispatchEvent(new Event("themechange"));
      });
      // se non c'è una scelta salvata, segui i cambi di tema del sistema
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
        let saved = null;
        try { saved = localStorage.getItem("theme"); } catch (err) {}
        if (saved) return;
        root.setAttribute("data-theme", e.matches ? "dark" : "light");
        window.dispatchEvent(new Event("themechange"));
      });

      // Riflesso "liquid glass": la luce segue il puntatore sulle superfici di vetro
      document.addEventListener("pointermove", (e) => {
        const el = (e.target as Element | null)?.closest?.(".card, .btn, .nav-bar") as HTMLElement | null;
        if (!el) return;
        const r = el.getBoundingClientRect();
        el.style.setProperty("--mx", `${e.clientX - r.left}px`);
        el.style.setProperty("--my", `${e.clientY - r.top}px`);
      }, { passive: true });

      // Scroll reveal: gli elementi con classe .reveal compaiono mentre scorri
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }),
          { threshold: 0.12 }
        );
        els.forEach((el, i) => {
          (el as HTMLElement).style.transitionDelay = `${(i % 4) * 80}ms`;
          io.observe(el);
        });
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

---
// Sfondo fisso in due strati:
//  1. composizione geometrica "low-poly" (sfaccettature traslucide, linee sottili con nodi)
//  2. uno scatter di dati rumorosi e una regressione (basi RBF) che si adatta con la
//     discesa del gradiente man mano che si scorre la pagina.
// Lo scroll è mappato sulla *distanza visibile* tra la curva corrente e il fit finale,
// così la curva si muove in modo uniforme dall'inizio alla fine della pagina
// invece di adattarsi quasi tutta nei primi pixel.
---
<canvas id="reg-bg" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('reg-bg') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');

    // ---------- Utilità ----------
    function mulberry32(a: number) {
      return () => {
        a |= 0; a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    const clamp01 = (x: number) => Math.min(1, Math.max(0, x));

    // ---------- Palette (chiaro / scuro) ----------
    type Pal = { facets: string[]; edge: string; thread: string; node: string; point: string; resid: string; curve: string; glow: string; label: string; facetAlpha: number };
    const LIGHT: Pal = {
      facets: ['#d9825f', '#e2672e', '#9dbfae', '#2f6b5a', '#d6ad5c', '#efe2cf', '#c96f4a'],
      edge: 'rgba(255,255,255,0.7)', thread: 'rgba(23,48,42,0.22)', node: 'rgba(160,120,50,0.8)',
      point: 'rgba(23,48,42,0.38)', resid: 'rgba(23,48,42,0.11)', curve: '#ff5a1f', glow: 'rgba(255,90,31,0.55)', label: 'rgba(23,48,42,0.5)',
      facetAlpha: 1,
    };
    const DARK: Pal = {
      facets: ['#b8613f', '#e2672e', '#5f8f7c', '#1f4a3e', '#c9962f', '#3a5a4f', '#8a4a32'],
      edge: 'rgba(255,255,255,0.18)', thread: 'rgba(236,227,212,0.18)', node: 'rgba(224,180,90,0.8)',
      point: 'rgba(236,227,212,0.42)', resid: 'rgba(236,227,212,0.11)', curve: '#f08a55', glow: 'rgba(240,138,85,0.35)', label: 'rgba(236,227,212,0.45)',
      facetAlpha: 0.75,
    };
    const pal = () => (document.documentElement.getAttribute('data-theme') === 'dark' ? DARK : LIGHT);

    // ---------- Composizione geometrica (seed fisso) ----------
    const g = mulberry32(1863);
    // ancore lungo una banda diagonale (basso-sinistra → alto-destra), sbilanciata a destra
    const anchors: [number, number][] = [];
    for (let i = 0; i < 26; i++) {
      const t = g();
      const bx = 0.38 + 0.68 * t, by = 1.02 - 0.95 * t;
      anchors.push([bx + (g() - 0.5) * 0.42, by + (g() - 0.5) * 0.38]);
    }
    for (let i = 0; i < 6; i++) anchors.push([0.05 + g() * 0.35, 0.1 + g() * 0.85]); // qualche ancora sparsa a sinistra

    type Facet = { pts: [number, number][]; c1: string; c2: string; a: number };
    const facets: Facet[] = [];
    const near = (i: number) =>
      anchors.map((p, j) => [j, Math.hypot(p[0] - anchors[i][0], p[1] - anchors[i][1])] as [number, number])
        .filter(([j]) => j !== i).sort((a, b) => a[1] - b[1]).slice(0, 6).map(([j]) => j);
    for (let k = 0; k < 30; k++) {
      const i = Math.floor(g() * 26); // le grandi sfaccettature solo nella banda
      const nb = near(i).filter((j) => j < 26);
      if (nb.length < 2) continue;
      const a = nb[Math.floor(g() * nb.length)];
      let b = nb[Math.floor(g() * nb.length)];
      if (a === b) b = nb[(nb.indexOf(a) + 1) % nb.length];
      const pc = LIGHT.facets.length;
      facets.push({
        pts: [anchors[i], anchors[a], anchors[b]],
        c1: String(Math.floor(g() * pc)), c2: String(Math.floor(g() * pc)),
        a: 0.18 + g() * 0.32,
      });
    }
    // piccole schegge a rombo, come nel poster
    const shards: { x: number; y: number; s: number; r: number; c: string }[] = [];
    for (let k = 0; k < 7; k++) shards.push({ x: g(), y: g(), s: 0.012 + g() * 0.022, r: g() * Math.PI, c: String(Math.floor(g() * 3)) });
    // fili sottili tra nodi
    const threads: [number, number][] = [];
    for (let k = 0; k < 14; k++) threads.push([Math.floor(g() * anchors.length), Math.floor(g() * anchors.length)]);

    // ---------- Dati della regressione ----------
    const rand = mulberry32(18);
    const gauss = () => Math.sqrt(-2 * Math.log(rand() + 1e-12)) * Math.cos(2 * Math.PI * rand());
    const truth = (x: number) => 0.5 + 0.22 * Math.sin(2 * Math.PI * 1.25 * x + 0.5) + 0.12 * (x - 0.5);
    const N = 90;
    const X: number[] = [], Y: number[] = [];
    for (let i = 0; i < N; i++) {
      const x = 0.02 + 0.96 * rand();
      X.push(x);
      Y.push(truth(x) + 0.065 * gauss());
    }

    const K = 9, width = 0.11;
    const centers = Array.from({ length: K }, (_, k) => k / (K - 1));
    const feats = (x: number) => [1, ...centers.map((c) => Math.exp(-((x - c) ** 2) / (2 * width * width)))];
    const D = K + 1;
    const Phi = X.map(feats);
    const GRID = 72;
    const PhiGrid = Array.from({ length: GRID + 1 }, (_, k) => feats(k / GRID));
    const dot = (f: number[], w: number[]) => f.reduce((s, fj, j) => s + fj * w[j], 0);

    // passo = 1/L (L stimato con power iteration su ΦᵀΦ/N)
    const gram = (v: number[]) => {
      const r = Phi.map((f) => dot(f, v));
      return Array.from({ length: D }, (_, j) => Phi.reduce((s, f, i) => s + f[j] * r[i], 0) / N);
    };
    let v = Array(D).fill(1);
    for (let it = 0; it < 50; it++) { const gv = gram(v); const n = Math.hypot(...gv); v = gv.map((x) => x / n); }
    const lr = 1 / Math.hypot(...gram(v)), ridge = 1e-4;

    // discesa del gradiente: salva pesi e loss a ogni passo
    const T = 6000;
    const W: number[][] = [], LOSS: number[] = [];
    let w = Array(D).fill(0);
    w[0] = Y.reduce((s, y) => s + y, 0) / N; // si parte dal modello con sola intercetta: retta piatta sulla media
    for (let t = 0; t <= T; t++) {
      const res = Phi.map((f, i) => dot(f, w) - Y[i]);
      W.push(w.slice());
      LOSS.push(res.reduce((s, r) => s + r * r, 0) / N);
      const grad = Array.from({ length: D }, (_, j) => Phi.reduce((s, f, i) => s + f[j] * res[i], 0) / N + ridge * w[j]);
      w = w.map((wj, j) => wj - lr * grad[j]);
    }
    // distanza (RMS sulla griglia) di ogni curva dal fit finale, resa monotona
    const final = PhiGrid.map((f) => dot(f, W[T]));
    const DIST = W.map((wt) => Math.sqrt(PhiGrid.reduce((s, f, k) => s + (dot(f, wt) - final[k]) ** 2, 0) / PhiGrid.length));
    for (let t = 1; t <= T; t++) DIST[t] = Math.min(DIST[t], DIST[t - 1]);

    // progresso di scroll → passo (frazionario) con distanza dal fit che cala linearmente
    function stepFor(p: number) {
      const q = clamp01((p - 0.03) / 0.92); // piccola zona morta all'inizio, fit completo poco prima del fondo
      const target = DIST[0] * (1 - q);
      if (target <= DIST[T]) return T;
      let lo = 0, hi = T;
      while (hi - lo > 1) { const mid = (lo + hi) >> 1; if (DIST[mid] > target) lo = mid; else hi = mid; }
      const span = DIST[lo] - DIST[hi];
      return lo + (span > 0 ? (DIST[lo] - target) / span : 0);
    }

    // ---------- Rendering ----------
    let VW = 0, VH = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let target = 0, cur = 0, raf = 0;

    function progress() {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      return max > 4 ? clamp01(window.scrollY / max) : 1;
    }

    function drawGeometry(P: Pal, p: number) {
      // leggera parallasse: la composizione sale e ruota appena mentre scorri
      ctx.save();
      ctx.translate(VW / 2, VH / 2);
      ctx.rotate((p - 0.5) * 0.035);
      ctx.translate(-VW / 2, -VH / 2 - p * VH * 0.06);
      const px = (pt: [number, number]): [number, number] => [pt[0] * VW, pt[1] * VH];

      ctx.globalAlpha = P.facetAlpha;
      for (const f of facets) {
        const [a, b, c] = f.pts.map(px);
        const grd = ctx.createLinearGradient(a[0], a[1], (b[0] + c[0]) / 2, (b[1] + c[1]) / 2);
        grd.addColorStop(0, P.facets[+f.c1]);
        grd.addColorStop(1, P.facets[+f.c2]);
        ctx.globalAlpha = P.facetAlpha * f.a;
        ctx.fillStyle = grd;
        ctx.beginPath(); ctx.moveTo(...a); ctx.lineTo(...b); ctx.lineTo(...c); ctx.closePath(); ctx.fill();
        ctx.globalAlpha = P.facetAlpha * 0.8;
        ctx.strokeStyle = P.edge; ctx.lineWidth = 1; ctx.stroke();
      }
      for (const s of shards) {
        const x = s.x * VW, y = s.y * VH, r = s.s * Math.max(VW, VH);
        ctx.globalAlpha = P.facetAlpha * 0.55;
        ctx.fillStyle = P.facets[+s.c];
        ctx.beginPath();
        for (let k = 0; k < 4; k++) {
          const ang = s.r + (k * Math.PI) / 2, rr = k % 2 ? r * 0.38 : r;
          const xx = x + Math.cos(ang) * rr, yy = y + Math.sin(ang) * rr;
          k ? ctx.lineTo(xx, yy) : ctx.moveTo(xx, yy);
        }
        ctx.closePath(); ctx.fill();
      }
      ctx.globalAlpha = 1;
      ctx.strokeStyle = P.thread; ctx.lineWidth = 0.7;
      ctx.beginPath();
      for (const [i, j] of threads) { ctx.moveTo(...px(anchors[i])); ctx.lineTo(...px(anchors[j])); }
      ctx.stroke();
      ctx.fillStyle = P.node;
      for (const [i, j] of threads) for (const k of [i, j]) {
        const [x, y] = px(anchors[k]);
        ctx.beginPath(); ctx.arc(x, y, 1.8, 0, Math.PI * 2); ctx.fill();
      }
      ctx.restore();
    }

    const sx = (x: number) => x * VW;
    const sy = (y: number) => VH * (0.9 - 0.72 * y);

    function draw() {
      const P = pal();
      ctx.clearRect(0, 0, VW, VH);
      drawGeometry(P, cur);

      const s = stepFor(cur);
      const i0 = Math.floor(s), i1 = Math.min(T, i0 + 1), u = s - i0;
      const wt = W[i0].map((x, j) => x + (W[i1][j] - x) * u);
      const loss = LOSS[i0] + (LOSS[i1] - LOSS[i0]) * u;

      ctx.strokeStyle = P.resid; ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i < N; i++) { ctx.moveTo(sx(X[i]), sy(Y[i])); ctx.lineTo(sx(X[i]), sy(dot(Phi[i], wt))); }
      ctx.stroke();

      ctx.fillStyle = P.point;
      for (let i = 0; i < N; i++) { ctx.beginPath(); ctx.arc(sx(X[i]), sy(Y[i]), 2.4, 0, Math.PI * 2); ctx.fill(); }

      ctx.save();
      ctx.shadowColor = P.glow; ctx.shadowBlur = 14;
      ctx.strokeStyle = P.curve; ctx.lineWidth = 2.5; ctx.lineJoin = 'round';
      ctx.beginPath();
      PhiGrid.forEach((f, k) => { const x = sx(k / GRID), y = sy(dot(f, wt)); k ? ctx.lineTo(x, y) : ctx.moveTo(x, y); });
      ctx.stroke();
      ctx.restore();

      ctx.fillStyle = P.label;
      ctx.font = '11px "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace';
      ctx.fillText(`step ${Math.round(s).toLocaleString('en')} · mse ${loss.toFixed(4)}`, 16, VH - 16);
    }

    function tick() {
      cur += (target - cur) * 0.08;
      if (Math.abs(target - cur) < 0.0004) cur = target;
      draw();
      raf = cur !== target ? requestAnimationFrame(tick) : 0;
    }

    function update() {
      target = progress();
      if (reduceMq.matches) { cur = target; draw(); return; }
      if (!raf) raf = requestAnimationFrame(tick);
    }

    function resize() {
      VW = window.innerWidth; VH = window.innerHeight;
      canvas!.width = VW * dpr; canvas!.height = VH * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
      update();
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', resize);
    window.addEventListener('themechange', draw);
    cur = target = progress();
    resize();
  }
</script>

<style>
  #reg-bg {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
  }
</style>
